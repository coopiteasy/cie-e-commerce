<odoo>
    <template id="total_ordered_weight" inherit_id="website_sale.total">
        <xpath expr="//div[@id='cart_total']/table/tr[last()]">
            <tr id="order_ordered_total_weight">
                <td class="text-end border-0">
                    Weight of products (<span
                        t-out="request.env['product.template'].sudo()._get_weight_uom_name_from_ir_config_parameter()"
                    />)
                </td>
                <td class="text-xl-end border-0">
                     <span t-field="website_sale_order.total_ordered_weight" />
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
