<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="website_publisher" inherit_id="website.website_publisher">
        <xpath
            expr="//li[@t-att-data-controller='publish_controller']"
            position="attributes"
        >
            <!--
                add o_disabled class if auto-publishing is enabled to make it
                appear disabled (lowered opacity)
            -->
            <attribute name="t-attf-class">
                js_publish_management
                {{extra_classes}}
                {{main_object.website_published and "css_published" or "css_unpublished"}}
                {{"o_disabled" if main_object.auto_managed_publishing else ""}}
            </attribute>
        </xpath>
        <xpath
            expr="//li[@t-att-data-controller='publish_controller']/label"
            position="attributes"
        >
            <!--
                remove js_publish_btn class if auto-publishing is enabled to
                disable the click event
            -->
            <attribute name="t-attf-class">
                o_switch o_switch_danger
                {{"" if main_object.auto_managed_publishing else "js_publish_btn"}}
            </attribute>
        </xpath>
    </template>
</odoo>
